# PayState Bridge — Environment Variables
# Copy to .env and fill values. NEVER commit .env.
# ALL values here are NAMES ONLY — no secrets.

# App
APP_ENV=demo
LOG_LEVEL=info

# Database (SQLite for dev)
DATABASE_URL=sqlite+aiosqlite:///./paystate.db

# Gemini (optional — use fake extractor without this)
GEMINI_API_KEY=

# Razorpay TEST MODE ONLY (never live keys)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
